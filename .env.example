# App
APP_NAME="Agent Notes"
APP_URL=http://agent-notes.test
APP_DEBUG=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent_notes
DB_USERNAME=root
DB_PASSWORD=password

# Limits
RATE_LIMIT_PER_MIN=60
NOTE_MAX_BYTES=1048576

# SMTP — primary (default)
MAIL_PRIMARY_HOST=smtp.example.com
MAIL_PRIMARY_PORT=587
MAIL_PRIMARY_USERNAME=user@example.com
MAIL_PRIMARY_PASSWORD=secret
MAIL_PRIMARY_ENCRYPTION=tls
MAIL_PRIMARY_FROM_ADDRESS=notes@example.com
MAIL_PRIMARY_FROM_NAME="Agent Notes"

# SMTP — failover (used when primary fails)
MAIL_FAILOVER_HOST=smtp2.example.com
MAIL_FAILOVER_PORT=587
MAIL_FAILOVER_USERNAME=user@example.com
MAIL_FAILOVER_PASSWORD=secret
MAIL_FAILOVER_ENCRYPTION=tls
MAIL_FAILOVER_FROM_ADDRESS=notes@example.com
MAIL_FAILOVER_FROM_NAME="Agent Notes"
