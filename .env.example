# App
APP_NAME="Agent Notes"
APP_URL=http://agent-notes.test
APP_DEBUG=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent_notes
DB_USERNAME=root
DB_PASSWORD=password

# Limits
RATE_LIMIT_PER_MIN=60
NOTE_MAX_BYTES=1048576

# Optional features, all off by default. With every flag off nothing changes, not even the SQL.
# Before turning on HTML notes, visibility or share links on an existing database, run: php bin/migrate.php
# (No inline comments in this file: the loader would read them as part of the value.)

# create_note format "html": full pages served under a CSP sandbox
FEATURE_HTML_NOTES=false

# upload_asset / delete_asset: images stored per note, outside public/ (default storage/assets)
FEATURE_ASSETS=false
ASSET_MAX_BYTES=5242880
ASSET_MAX_PER_NOTE=50
ASSET_STORAGE_PATH=

# tailnet/public split across two listeners (see deploy/README.md); PUBLIC_URL is the public host
FEATURE_VISIBILITY=false
PUBLIC_URL=

# expiring read links to tailnet notes, served on the public host (needs FEATURE_VISIBILITY)
FEATURE_SHARE_LINKS=false
SHARE_LINK_TTL_DEFAULT_HOURS=168
SHARE_LINK_TTL_MAX_HOURS=720
SHARE_COOKIE_TTL_HOURS=12
SHARE_LINK_RATE_PER_MIN=30

# Optional: full path to mysqldump for the admin DB export (auto-detected if empty)
MYSQLDUMP_PATH=

# SMTP — primary (default)
MAIL_PRIMARY_HOST=smtp.example.com
MAIL_PRIMARY_PORT=587
MAIL_PRIMARY_USERNAME=user@example.com
MAIL_PRIMARY_PASSWORD=secret
MAIL_PRIMARY_ENCRYPTION=tls
MAIL_PRIMARY_FROM_ADDRESS=notes@example.com
MAIL_PRIMARY_FROM_NAME="Agent Notes"

# SMTP — failover (used when primary fails)
MAIL_FAILOVER_HOST=smtp2.example.com
MAIL_FAILOVER_PORT=587
MAIL_FAILOVER_USERNAME=user@example.com
MAIL_FAILOVER_PASSWORD=secret
MAIL_FAILOVER_ENCRYPTION=tls
MAIL_FAILOVER_FROM_ADDRESS=notes@example.com
MAIL_FAILOVER_FROM_NAME="Agent Notes"
